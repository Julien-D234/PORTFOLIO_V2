---
import Layout from '../layouts/Layout.astro';
---

<Layout lang="fr" title="404 — Page introuvable">
  <section class="flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="mono text-6xl font-bold text-accent">404</p>
    <h1 class="mono mt-4 text-xl font-semibold">Page introuvable</h1>
    <p class="mt-2 text-sm text-muted">Cette page n'existe pas ou a été déplacée.</p>
    <a
      href="/"
      class="mono mt-8 border border-accent px-6 py-3 text-sm font-semibold text-accent transition-colors hover:bg-accent hover:text-black"
    >
      ← Retour à l'accueil
    </a>
  </section>
</Layout>
