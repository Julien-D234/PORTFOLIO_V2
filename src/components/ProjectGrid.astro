---
import { ArrowUpRight } from 'lucide-astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  projects: {
    id: string;
    title: string;
    description: string;
    techs: string[];
    link?: string;
  }[];
}

const { lang, projects } = Astro.props;
const t = useTranslations(lang);
---

<section id="projects" class="mx-auto w-full max-w-6xl scroll-mt-20 px-5 py-16 sm:px-8 lg:py-24">
  <div class="mb-12 flex items-end justify-between">
    <div>
      <p class="eyebrow">[ /projects ]</p>
      <h2 class="mt-3 text-4xl font-bold uppercase sm:text-5xl">
        {t('projects.title')}
      </h2>
    </div>
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-faint">
      ({String(projects.length).padStart(2, '0')}) entrées
    </p>
  </div>

  {projects.length > 0 ? (
    <div class="border-t border-border">
      {projects.map((p, idx) => {
        const n = String(idx + 1).padStart(2, '0');
        return (
          <a
            href={p.link ?? '#projects'}
            target={p.link ? '_blank' : undefined}
            rel={p.link ? 'noopener noreferrer' : undefined}
            class="group grid grid-cols-[auto_1fr_auto] items-center gap-5 border-b border-border py-7 transition-colors hover:bg-surface/40 sm:gap-8 sm:py-9"
          >
            <span class="giant-numeral text-4xl transition-colors group-hover:text-accent sm:text-6xl">
              {n}
            </span>

            <div class="min-w-0">
              <h3 class="font-display text-2xl font-bold uppercase leading-tight text-foreground transition-colors group-hover:text-accent sm:text-4xl">
                {p.title || '—'}
              </h3>
              <p class="mt-2 max-w-xl text-sm leading-relaxed text-muted">{p.description}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {p.techs.map((tech) => (
                  <span class="border border-border px-2 py-0.5 font-mono text-[0.65rem] uppercase tracking-[0.08em] text-faint transition-colors group-hover:border-accent/50 group-hover:text-accent-soft">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <ArrowUpRight class="h-5 w-5 text-faint transition-all duration-300 group-hover:-translate-y-1 group-hover:translate-x-1 group-hover:text-accent" />
          </a>
        );
      })}
    </div>
  ) : (
    <div class="frame-corners border border-dashed border-border bg-surface/40 p-12 text-center">
      <p class="eyebrow">[ empty ]</p>
      <p class="mt-3 font-mono text-sm text-muted">{t('projects.empty')}</p>
    </div>
  )}
</section>
