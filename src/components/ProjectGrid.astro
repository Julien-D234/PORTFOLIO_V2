---
import { useTranslations, type Lang } from '../i18n/ui';
import ProjectCard from './ProjectCard.astro';

interface Props {
  lang: Lang;
  projects: {
    id: string;
    title: string;
    description: string;
    techs: string[];
    link?: string;
  }[];
}

const { lang, projects } = Astro.props;
const t = useTranslations(lang);
---

<section id="projects" class="mx-auto w-full max-w-6xl scroll-mt-20 px-5 py-16 sm:px-8 lg:py-24">
  <div class="mb-12">
    <p class="eyebrow">[ /projects ]</p>
    <h2 class="mt-3 flex items-baseline gap-4 text-4xl font-bold uppercase sm:text-5xl">
      {t('projects.title')}
      <span class="text-2xl text-accent">({String(projects.length).padStart(2, '0')})</span>
    </h2>
    <p class="mt-3 max-w-lg text-sm leading-relaxed text-muted">{t('projects.subtitle')}</p>
  </div>

  {projects.length > 0 ? (
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p, idx) => (
        <ProjectCard
          id={String(idx + 1).padStart(2, '0')}
          title={p.title}
          description={p.description}
          techs={p.techs}
          link={p.link}
          lang={lang}
        />
      ))}
    </div>
  ) : (
    <div class="frame-corners border border-dashed border-border bg-surface/40 p-12 text-center">
      <p class="eyebrow">[ empty ]</p>
      <p class="mt-3 font-mono text-sm text-muted">{t('projects.empty')}</p>
    </div>
  )}
</section>
