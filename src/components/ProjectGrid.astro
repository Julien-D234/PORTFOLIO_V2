---
import { ArrowUpRight } from 'lucide-astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  projects: {
    id: string;
    title: string;
    description: string;
    techs: string[];
    link?: string;
  }[];
}

const { lang, projects } = Astro.props;
const t = useTranslations(lang);
---

<section id="projects" class="mx-auto w-full max-w-6xl scroll-mt-20 px-5 py-20 sm:px-8 lg:py-28">
  <div class="mb-12 flex items-end justify-between">
    <div>
      <p class="eyebrow text-accent">[ /projects ]</p>
      <h2 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">{t('projects.title')}</h2>
    </div>
    <p class="font-mono text-xs text-faint">
      {String(projects.length).padStart(2, '0')} entrées
    </p>
  </div>

  {projects.length > 0 ? (
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p, idx) => (
        <a
          href={p.link ?? '#projects'}
          target={p.link ? '_blank' : undefined}
          rel={p.link ? 'noopener noreferrer' : undefined}
          class="group flex flex-col border border-border bg-surface p-6 transition-colors duration-300 hover:border-accent/60"
        >
          <div class="flex items-center justify-between">
            <span class="font-mono text-sm text-accent">#{String(idx + 1).padStart(2, '0')}</span>
            <ArrowUpRight class="h-4 w-4 text-faint transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent" />
          </div>

          <h3 class="mt-8 text-xl font-bold tracking-tight text-foreground transition-colors group-hover:text-accent-soft">
            {p.title || '—'}
          </h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{p.description}</p>

          <div class="mt-6 flex flex-wrap gap-2">
            {p.techs.map((tech) => (
              <span class="border border-border px-2 py-1 font-mono text-[0.66rem] text-muted transition-colors group-hover:border-accent/40 group-hover:text-accent">
                {tech}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div class="border border-dashed border-border bg-surface p-14 text-center">
      <p class="eyebrow text-accent">[ empty ]</p>
      <p class="mt-4 font-mono text-sm text-muted">{t('projects.empty')}</p>
    </div>
  )}
</section>
