---
import { ArrowUpRight } from 'lucide-astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  projects: {
    id: string;
    title: string;
    description: string;
    techs: string[];
    link?: string;
  }[];
}

const { lang, projects } = Astro.props;
const t = useTranslations(lang);

const badgeColors = ['bg-accent', 'bg-accent-yellow', 'bg-accent-pink', 'bg-accent-green'];
const badgeText = ['text-white', 'text-foreground', 'text-white', 'text-foreground'];
---

<section id="projects" class="mx-auto w-full max-w-6xl scroll-mt-20 px-5 py-16 sm:px-8 lg:py-24">
  <div class="mb-12 flex flex-wrap items-end justify-between gap-4">
    <div>
      <span class="sticker -rotate-1 bg-accent-pink text-white">[ /projects ]</span>
      <h2 class="mt-6 text-5xl uppercase sm:text-6xl">
        {t('projects.title')}
      </h2>
    </div>
    <span class="sticker rotate-2 bg-accent-yellow">
      {String(projects.length).padStart(2, '0')} entrées
    </span>
  </div>

  {projects.length > 0 ? (
    <div class="grid gap-8 sm:grid-cols-2">
      {projects.map((p, idx) => {
        const n = String(idx + 1).padStart(2, '0');
        const bg = badgeColors[idx % badgeColors.length];
        const tx = badgeText[idx % badgeText.length];
        return (
          <article class="group flex flex-col border-[3px] border-border bg-surface p-6 shadow-hard transition-transform hover:-translate-x-1 hover:-translate-y-1 hover:shadow-hard-accent">
            <div class="flex items-center justify-between">
              <span class={`sticker ${bg} ${tx}`}>#{n}</span>
              <ArrowUpRight class="h-6 w-6 transition-transform group-hover:-translate-y-1 group-hover:translate-x-1" />
            </div>

            <h3 class="mt-6 text-3xl uppercase leading-tight">{p.title || '—'}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{p.description}</p>

            <div class="mt-5 flex flex-wrap gap-2">
              {p.techs.map((tech) => (
                <span class="border-2 border-border bg-background px-2 py-1 font-mono text-[0.68rem] font-bold uppercase tracking-wide">
                  {tech}
                </span>
              ))}
            </div>

            {p.link && (
              <a
                href={p.link}
                target="_blank"
                rel="noopener noreferrer"
                class="btn mt-6 w-full justify-center bg-accent-yellow"
              >
                {t('projects.view')} <span aria-hidden="true">→</span>
              </a>
            )}
          </article>
        );
      })}
    </div>
  ) : (
    <div class="border-[3px] border-dashed border-border bg-surface p-12 text-center shadow-hard">
      <span class="sticker bg-accent-yellow">[ empty ]</span>
      <p class="mt-4 font-mono text-sm font-bold uppercase tracking-wide text-muted">{t('projects.empty')}</p>
    </div>
  )}
</section>
