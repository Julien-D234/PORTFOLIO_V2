---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLang = lang === 'fr' ? 'en' : 'fr';
const base = import.meta.env.BASE_URL;
const rootLink = base;
const langLink = otherLang === 'fr' ? base : `${base}en`;
---

<header class="sticky top-0 z-50 border-b border-border bg-background/85 backdrop-blur">
  <nav class="mx-auto flex w-full max-w-6xl items-center justify-between px-5 py-4 sm:px-8">
    <a href={rootLink} class="group flex items-center gap-3">
      <span class="h-3 w-3 rotate-45 border border-accent bg-accent/30 transition-colors group-hover:bg-accent"></span>
      <span class="font-display text-sm font-bold uppercase tracking-[0.2em] text-foreground">
        julien<span class="text-accent">·druelle</span>
      </span>
    </a>

    <div class="flex items-center gap-4 sm:gap-6">
      <a href="#projects" class="font-mono text-[0.72rem] uppercase tracking-[0.15em] text-muted transition-colors hover:text-foreground">
        {t('nav.projects')}
      </a>
      <a href="#contact" class="font-mono text-[0.72rem] uppercase tracking-[0.15em] text-muted transition-colors hover:text-foreground">
        {t('nav.contact')}
      </a>
      <a href={langLink} class="font-mono text-[0.72rem] uppercase tracking-[0.15em] text-accent-soft transition-colors hover:text-accent"
        aria-label={otherLang === 'fr' ? 'Passer en français' : 'Switch to English'}>
        {otherLang === 'fr' ? 'FR' : 'EN'}
      </a>
      <span class="hidden items-center gap-2 border-l border-border pl-4 sm:flex">
        <span class="h-2 w-2 bg-accent animate-blink"></span>
        <span class="font-mono text-[0.68rem] uppercase tracking-[0.15em] text-muted">{t('nav.status')}</span>
      </span>
    </div>
  </nav>
</header>
