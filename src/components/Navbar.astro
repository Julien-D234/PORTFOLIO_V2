---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLang = lang === 'fr' ? 'en' : 'fr';
---

<header class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur">
  <nav class="mx-auto flex w-full max-w-4xl items-center justify-between px-5 py-4 sm:px-8">
    <a href="/" class="mono text-sm font-semibold tracking-tight text-foreground hover:text-accent">
      julien@dev<span class="text-accent">:~$</span>
    </a>

    <div class="flex items-center gap-5">
      <span class="hidden items-center gap-2 sm:flex">
        <span class="h-2 w-2 rounded-none bg-accent animate-blink"></span>
        <span class="mono text-xs text-muted">{t('nav.status')}</span>
      </span>

      <a href="#projects" class="mono text-xs text-muted transition-colors hover:text-foreground">
        {t('nav.projects')}
      </a>
      <a href="#contact" class="mono text-xs text-muted transition-colors hover:text-foreground">
        {t('nav.contact')}
      </a>

      <a
        href={otherLang === 'fr' ? '/' : '/en'}
        class="mono text-xs text-accent transition-colors hover:text-accent-violet"
        aria-label={otherLang === 'fr' ? 'Passer en français' : 'Switch to English'}
      >
        {otherLang === 'fr' ? 'FR' : 'EN'}
      </a>
    </div>
  </nav>
</header>
