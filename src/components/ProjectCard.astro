---
import { ArrowUpRight } from 'lucide-astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  id: string;
  title: string;
  description: string;
  techs: string[];
  link?: string;
  lang: Lang;
}

const { id, title, description, techs, link, lang } = Astro.props;
const t = useTranslations(lang);
---

<article class="frame-corners frame-corners-hover group relative flex flex-col border border-border bg-surface/50 p-6 transition-colors duration-300 hover:border-accent/70">
  <!-- barre latérale au hover -->
  <span class="absolute inset-y-0 left-0 w-1 origin-bottom scale-y-0 bg-accent transition-transform duration-300 group-hover:scale-y-100"></span>

  <div class="flex items-center justify-between">
    <span class="font-mono text-xs uppercase tracking-[0.2em] text-accent">#{id}</span>
    <span class="font-mono text-[0.65rem] uppercase tracking-[0.1em] text-faint">
      ./projects/{id}.md
    </span>
    <ArrowUpRight class="h-4 w-4 text-faint transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent" />
  </div>

  <h3 class="mt-6 text-2xl font-bold uppercase leading-tight text-foreground transition-colors group-hover:text-accent">
    {title || '—'}
  </h3>

  <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{description}</p>

  <div class="mt-6 flex flex-wrap gap-2">
    {techs.map((tech) => (
      <span class="border border-border px-2 py-1 font-mono text-[0.68rem] uppercase tracking-[0.08em] text-muted transition-colors group-hover:border-accent/50 group-hover:text-accent-soft">
        {tech}
      </span>
    ))}
  </div>

  {link && (
    <a
      href={link}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-7 inline-flex items-center gap-2 border-t border-border pt-4 font-display text-sm font-bold uppercase tracking-[0.15em] text-foreground transition-colors hover:text-accent"
    >
      {t('projects.view')} <span aria-hidden="true">→</span>
    </a>
  )}
</article>
