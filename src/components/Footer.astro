---
import { Github, Linkedin, Twitter, Mail } from 'lucide-astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const socials = [
  { href: 'https://github.com/Julien-D234', label: 'GitHub', icon: Github },
  { href: 'https://www.linkedin.com/', label: 'LinkedIn', icon: Linkedin },
  { href: 'https://twitter.com/', label: 'Twitter', icon: Twitter },
  { href: 'mailto:contact@example.com', label: 'Email', icon: Mail },
];
---

<footer id="contact" class="border-t border-border">
  <div class="mx-auto w-full max-w-6xl px-5 py-14 sm:px-8">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow">[ /contact ]</p>
        <h2 class="mt-3 text-3xl font-bold uppercase sm:text-4xl">
          Travaillons <span class="text-accent">ensemble</span>
        </h2>
        <p class="mt-3 max-w-md font-mono text-xs uppercase tracking-[0.12em] text-muted">
          julien.druelle007@gmail.com
        </p>
      </div>

      <div class="flex items-center gap-3">
        {socials.map(({ href, label, icon: Icon }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={label}
            title={label}
            class="group flex h-11 w-11 items-center justify-center border border-border text-muted transition-colors hover:border-accent hover:text-accent"
          >
            <Icon class="h-5 w-5 transition-colors group-hover:text-accent" />
          </a>
        ))}
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-border pt-6 sm:flex-row sm:items-center">
      <p class="font-display text-xs font-bold uppercase tracking-[0.2em] text-faint">
        © {new Date().getFullYear()} Julien Druelle — {t('footer.rights')}
      </p>
      <p class="font-mono text-[0.68rem] uppercase tracking-[0.15em] text-faint">{t('footer.built')}</p>
    </div>
  </div>
</footer>
