---
import { Github, Linkedin, Twitter, Mail } from 'lucide-astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const socials = [
  { href: 'https://github.com/Julien-D234', label: 'GitHub', icon: Github },
  { href: 'https://www.linkedin.com/', label: 'LinkedIn', icon: Linkedin },
  { href: 'https://twitter.com/', label: 'Twitter', icon: Twitter },
  { href: 'mailto:contact@example.com', label: 'Email', icon: Mail },
];
---

<footer id="contact" class="border-t-[3px] border-border">
  <div class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-8">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <span class="sticker -rotate-1 bg-accent text-white">[ /contact ]</span>
        <h2 class="mt-6 text-5xl uppercase leading-none sm:text-6xl">
          Travaillons
          <span class="mt-2 inline-block bg-accent-yellow px-2">ensemble</span>
        </h2>
        <p class="mt-6 font-mono text-sm font-bold uppercase tracking-wide text-muted">
          julien.druelle007@gmail.com
        </p>
      </div>

      <div class="flex items-center gap-3">
        {socials.map(({ href, label, icon: Icon }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={label}
            title={label}
            class="flex h-12 w-12 items-center justify-center border-[3px] border-border bg-surface shadow-hard-sm transition-transform hover:-translate-y-1"
          >
            <Icon class="h-5 w-5" />
          </a>
        ))}
      </div>
    </div>

    <div class="mt-14 flex flex-col items-start justify-between gap-3 border-t-[3px] border-border pt-6 sm:flex-row sm:items-center">
      <p class="font-mono text-xs font-bold uppercase tracking-wide text-muted">
        © {new Date().getFullYear()} Julien Druelle — {t('footer.rights')}
      </p>
      <p class="font-mono text-xs font-bold uppercase tracking-wide text-muted">{t('footer.built')}</p>
    </div>
  </div>
</footer>
