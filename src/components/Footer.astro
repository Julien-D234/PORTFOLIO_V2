---
import { Github, Linkedin, Twitter, Mail } from 'lucide-astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const socials = [
  { href: 'https://github.com/Julien-D234', label: 'GitHub', icon: Github },
  { href: 'https://www.linkedin.com/', label: 'LinkedIn', icon: Linkedin },
  { href: 'https://twitter.com/', label: 'Twitter', icon: Twitter },
  { href: 'mailto:contact@example.com', label: 'Email', icon: Mail },
];
---

<footer id="contact" class="border-t border-border">
  <div class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-8">
    <p class="eyebrow text-accent">[ /contact ]</p>
    <h2 class="mt-4 max-w-xl text-4xl font-bold leading-tight tracking-tight sm:text-6xl">
      Travaillons <span class="text-accent">ensemble</span>
    </h2>

    <div class="mt-10 flex flex-col gap-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono text-sm text-muted">
        <span class="text-accent">$</span> echo "bonjour" | mail julien.druelle007@gmail.com
      </p>

      <div class="flex items-center gap-3">
        {socials.map(({ href, label, icon: Icon }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={label}
            title={label}
            class="flex h-11 w-11 items-center justify-center border border-border text-muted transition-colors hover:border-accent hover:text-accent"
          >
            <Icon class="h-5 w-5" />
          </a>
        ))}
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-2 border-t border-border pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono text-xs text-faint">
        © {new Date().getFullYear()} Julien Druelle — {t('footer.rights')}
      </p>
      <p class="font-mono text-xs text-faint">{t('footer.built')}</p>
    </div>
  </div>
</footer>
