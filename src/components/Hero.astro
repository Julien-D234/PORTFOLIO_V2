---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const marquee = [
  'PROJETS',
  'DÉVELOPPEMENT',
  'WEB',
  'UI / UX',
  'OPEN SOURCE',
  'FRONTEND',
  'CRÉATIF',
].map((w) => (lang === 'en' ? w.replace('PROJETS','PROJECTS').replace('DÉVELOPPEMENT','DEVELOPMENT').replace('CRÉATIF','CREATIVE') : w));
---

<section id="top" class="relative overflow-hidden">
  <div class="mx-auto grid w-full max-w-6xl gap-12 px-5 pb-16 pt-14 sm:px-8 lg:min-h-[82vh] lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:pb-20 lg:pt-16">
    <!-- ===== Colonne gauche : contenu ===== -->
    <div>
      <p class="eyebrow animate-fade-up">[ {t('hero.role')} ]</p>

      <h1 class="mt-6 animate-fade-up delay-1">
        <span class="block text-5xl font-bold uppercase sm:text-7xl lg:text-8xl">Julien</span>
        <span class="block text-5xl font-bold uppercase sm:text-7xl lg:text-8xl">
          <span class="text-accent">Dr</span>uelle
        </span>
      </h1>

      <div class="mt-8 h-px w-24 bg-accent animate-fade-up delay-2"></div>

      <p class="mt-8 max-w-md text-[15px] leading-relaxed text-muted animate-fade-up delay-3">
        {t('hero.tagline')}
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-4 animate-fade-up delay-4">
        <a
          href="#projects"
          class="group inline-flex items-center gap-2 border border-accent bg-accent px-7 py-3.5 font-display text-sm font-bold uppercase tracking-[0.15em] text-black transition-colors hover:bg-transparent hover:text-accent"
        >
          {t('hero.cta')}
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 border border-border px-7 py-3.5 font-display text-sm font-bold uppercase tracking-[0.15em] text-foreground transition-colors hover:border-accent hover:text-accent"
        >
          {t('nav.contact')}
        </a>
      </div>

      <p class="mt-10 flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.15em] text-muted animate-fade-up delay-5">
        <span class="h-2 w-2 rounded-full bg-accent animate-node"></span>
        online — {lang === 'fr' ? 'disponible pour projets' : 'open to work'}
      </p>
    </div>

    <!-- ===== Colonne droite : motif graphique ===== -->
    <div class="hidden animate-fade-in delay-2 lg:block">
      <div class="frame-corners relative select-none border border-border bg-surface/40">
        <!-- grille blueprint interne -->
        <div class="pointer-events-none absolute inset-0 opacity-40"
          style="background-image:linear-gradient(color-mix(in srgb,#3f63ff 8%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,#3f63ff 8%,transparent) 1px,transparent 1px);background-size:26px 26px;"></div>

        <!-- marks de repérage -->
        <span class="absolute left-3 top-3 font-mono text-lg text-accent-soft/70">＋</span>
        <span class="absolute right-3 top-3 font-mono text-xs text-accent-soft/70">⊙</span>
        <span class="absolute bottom-3 left-3 font-mono text-xs text-accent-soft/70">✕</span>
        <span class="absolute right-10 top-10 h-1.5 w-1.5 bg-accent animate-blink"></span>

        <div class="relative flex aspect-[3/4] flex-col items-center justify-center gap-10 px-10 py-16">
          <!-- monogramme en contour -->
          <div class="text-8xl font-bold uppercase leading-none text-stroke">JD</div>

          <!-- nœud lumineux + anneau -->
          <div class="relative flex h-20 w-20 items-center justify-center">
            <span class="absolute inset-0 rounded-full border border-accent/40 animate-glow"></span>
            <span class="absolute -inset-3 rounded-full border border-dashed border-accent/30"></span>
            <span class="h-3 w-3 rounded-full bg-accent animate-node"></span>
          </div>

          <!-- rail de signal vertical -->
          <div class="flex flex-col gap-1.5">
            <span class="block h-2 w-16 bg-accent"></span>
            <span class="block h-2 w-16 bg-accent/60"></span>
            <span class="block h-2 w-16 bg-accent/35"></span>
            <span class="block h-2 w-16 bg-accent/15"></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== Bandeau défilant (marquee) ===== -->
  <div class="relative overflow-hidden border-y border-border bg-surface/60 py-3">
    <div class="flex w-max animate-marquee">
      {[...marquee, ...marquee].map((w) => (
        <span class="mx-6 flex items-center gap-6 whitespace-nowrap font-display text-sm font-bold uppercase tracking-[0.25em] text-muted">
          {w} <span class="text-accent">/</span>
        </span>
      ))}
    </div>
  </div>
</section>
