---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const marquee = (lang === 'fr'
  ? ['PROJETS', 'DÉVELOPPEMENT', 'WEB', 'UI / UX', 'OPEN SOURCE', 'FRONTEND', 'CRÉATIF']
  : ['PROJECTS', 'DEVELOPMENT', 'WEB', 'UI / UX', 'OPEN SOURCE', 'FRONTEND', 'CREATIVE']);
---

<section id="top" class="relative overflow-hidden">
  <!-- En-tête de document (métadonnées) -->
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-5 pt-6 sm:px-8">
    <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-faint">
      portfolio_v2 — julien druelle — {new Date().getFullYear()}
    </p>
    <p class="hidden font-mono text-[0.65rem] uppercase tracking-[0.2em] text-faint sm:block">
      <span class="text-accent">＋</span> index / 01
    </p>
  </div>

  <div class="mx-auto grid w-full max-w-6xl gap-10 px-5 pb-16 pt-8 sm:px-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:pb-20 lg:pt-10">
    <!-- ===== Colonne gauche : nom géant en serif ===== -->
    <div class="relative">
      <p class="eyebrow animate-fade-up">[ {t('hero.role')} ]</p>

      <h1 class="mt-6 animate-fade-up delay-1">
        <span class="block font-serif text-[17vw] font-black leading-[0.9] tracking-tight sm:text-8xl lg:text-[7.5rem]">
          Julien
        </span>
        <span class="block font-serif text-[17vw] font-black italic leading-[0.9] tracking-tight text-accent sm:text-8xl lg:text-[7.5rem]">
          Druelle
        </span>
      </h1>

      <div class="ruled mt-10 w-full max-w-md animate-fade-up delay-2"></div>

      <p class="mt-6 max-w-md text-[15px] leading-relaxed text-muted animate-fade-up delay-3">
        {t('hero.tagline')}
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-4 animate-fade-up delay-4">
        <a
          href="#projects"
          class="group inline-flex items-center gap-3 border border-accent bg-accent px-7 py-3.5 font-display text-sm font-bold uppercase tracking-[0.15em] text-black transition-colors hover:bg-transparent hover:text-accent"
        >
          <span class="font-mono text-xs">[01]</span>
          {t('hero.cta')}
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
        <a
          href="#contact"
          class="inline-flex items-center gap-3 border border-foreground/30 px-7 py-3.5 font-display text-sm font-bold uppercase tracking-[0.15em] text-foreground transition-colors hover:border-accent hover:text-accent"
        >
          <span class="font-mono text-xs text-faint">[02]</span>
          {t('nav.contact')}
        </a>
      </div>

      <p class="mt-10 flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.15em] text-muted animate-fade-up delay-5">
        <span class="h-2 w-2 rounded-full bg-accent animate-node"></span>
        online — {lang === 'fr' ? 'disponible pour projets' : 'open to work'}
      </p>
    </div>

    <!-- ===== Colonne droite : astérisque géant ===== -->
    <div class="relative hidden animate-fade-in delay-2 lg:block">
      <div class="frame-corners relative select-none border border-border bg-surface/40">
        <div class="pointer-events-none absolute inset-0 opacity-40"
          style="background-image:linear-gradient(color-mix(in srgb,#3f63ff 8%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,#3f63ff 8%,transparent) 1px,transparent 1px);background-size:26px 26px;"></div>

        <span class="absolute left-3 top-3 font-mono text-lg text-accent-soft/70">＋</span>
        <span class="absolute right-3 top-3 font-mono text-xs text-accent-soft/70">⊙</span>
        <span class="absolute bottom-3 left-3 font-mono text-xs text-accent-soft/70">✕</span>

        <div class="relative flex aspect-square flex-col items-center justify-center gap-8 px-10 py-12">
          <div class="animate-spin-slow text-accent" style="font-size:9rem;line-height:1;font-weight:200;">✳</div>
          <div class="flex items-center gap-3">
            <span class="h-2.5 w-2.5 rounded-full bg-accent animate-node"></span>
            <span class="font-mono text-[0.65rem] uppercase tracking-[0.25em] text-muted">fig. 01 — signal</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== Bandeau défilant ===== -->
  <div class="relative overflow-hidden border-y border-border bg-surface/60 py-3">
    <div class="flex w-max animate-marquee">
      {[...marquee, ...marquee].map((w) => (
        <span class="mx-6 flex items-center gap-6 whitespace-nowrap font-display text-sm font-bold uppercase tracking-[0.25em] text-muted">
          {w} <span class="text-accent">/</span>
        </span>
      ))}
    </div>
  </div>
</section>
