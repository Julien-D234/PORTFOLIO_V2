---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const marquee = (lang === 'fr'
  ? ['PROJETS', 'DÉVELOPPEMENT', 'WEB', 'UI / UX', 'OPEN SOURCE', 'FRONTEND', 'CRÉATIF']
  : ['PROJECTS', 'DEVELOPMENT', 'WEB', 'UI / UX', 'OPEN SOURCE', 'FRONTEND', 'CREATIVE']);
---

<section id="top" class="relative overflow-hidden">
  <div class="mx-auto grid w-full max-w-6xl gap-12 px-5 pb-16 pt-12 sm:px-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:pb-20 lg:pt-16">
    <!-- ===== Colonne gauche ===== -->
    <div class="relative">
      <span class="sticker -rotate-2 bg-accent-yellow animate-fade-up">✳ {t('hero.role')}</span>

      <h1 class="mt-8 animate-fade-up delay-1">
        <span class="block text-6xl uppercase leading-[0.9] sm:text-8xl lg:text-[6.5rem]">Julien</span>
        <span class="mt-2 inline-block bg-accent-yellow px-3 text-6xl uppercase leading-[0.9] sm:text-8xl lg:text-[6.5rem]">
          Druelle
        </span>
      </h1>

      <p class="mt-8 max-w-md text-lg leading-relaxed text-muted animate-fade-up delay-2">
        {t('hero.tagline')}
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-4 animate-fade-up delay-3">
        <a href="#projects" class="btn bg-accent text-white">
          {t('hero.cta')} <span aria-hidden="true">→</span>
        </a>
        <a href="#contact" class="btn bg-surface">
          {t('nav.contact')}
        </a>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-3 animate-fade-up delay-4">
        <span class="sticker rotate-1 bg-accent-green">
          <span class="mr-1 inline-block h-2.5 w-2.5 bg-foreground animate-blink"></span>
          online
        </span>
        <span class="font-mono text-xs font-bold uppercase tracking-wide text-muted">
          {lang === 'fr' ? 'disponible pour projets' : 'open to work'}
        </span>
      </div>
    </div>

    <!-- ===== Colonne droite : carte graphique ===== -->
    <div class="relative hidden animate-fade-in delay-2 lg:block">
      <div class="relative rotate-2 border-[3px] border-border bg-accent-yellow p-8 shadow-hard">
        <div class="flex aspect-square flex-col items-center justify-center gap-6 border-[3px] border-border bg-surface">
          <span class="text-8xl leading-none">⚡</span>
          <span class="sticker -rotate-3 bg-accent-pink text-white">hello!</span>
        </div>
        <span class="sticker absolute -left-4 -top-4 rotate-[-6deg] bg-accent text-white">dev</span>
        <span class="sticker absolute -bottom-4 -right-3 rotate-3 bg-accent-green">2026</span>
      </div>
    </div>
  </div>

  <!-- ===== Bandeau défilant ===== -->
  <div class="relative overflow-hidden border-y-[3px] border-border bg-accent-yellow py-3">
    <div class="flex w-max animate-marquee">
      {[...marquee, ...marquee].map((w) => (
        <span class="mx-6 flex items-center gap-6 whitespace-nowrap font-display text-sm uppercase tracking-wide">
          {w} <span class="text-accent">✳</span>
        </span>
      ))}
    </div>
  </div>
</section>
